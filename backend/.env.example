# ═══════════════════════════════════════════════════════════════════════════════
#  Drape API — environment template
#  docs/ARCHITECTURE.md §7 is the authoritative table. Every API variable it lists
#  appears below, grouped by concern.
#
#  HOW TO USE
#    cp .env.example .env      (Windows: copy .env.example .env)
#    then fill in every value marked  <<< REQUIRED — NO DEFAULT >>>
#
#  RULES (PRD E-2, ARCHITECTURE.md §0, CLAUDE.md)
#    • No secret in this file has a working value, and none ever gets a fallback
#      default in code. A missing required variable fails at boot, never at request
#      time — `validateRequiredEnvVars()` runs before `NestFactory.create()`.
#    • `.env` is git-ignored. This template is the only env file that is committed.
#    • Web variables (NEXT_PUBLIC_*, API_INTERNAL_URL) do NOT belong here. They live
#      in frontend/apps/web/.env.*. The web service holds no database URL, no session
#      secret and no TryOnCloud key (B-1, B-2, B-3).
#
#  Generating a 64-hex secret:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#  Use a DIFFERENT value for every secret. Never reuse one across environments.
# ═══════════════════════════════════════════════════════════════════════════════


# ── Runtime ───────────────────────────────────────────────────────────────────

# development | staging | production (E-1). Drives pool sizing, cookie Secure
# defaults and log verbosity.
NODE_ENV=development

# HTTP port the API listens on.
API_PORT=4000

# The web origin. Used for links in verification / reset / notification emails and
# for the A-32 QR and Instagram short link.
APP_WEB_URL=http://localhost:3000

# Public base URL of this API. Signed file URLs are built as
# {APP_API_URL}/api/v1/files/{token} (§3.4), so this must be reachable by a browser.
APP_API_URL=http://localhost:4000

# Comma-separated CORS allow-list. NEVER `*`, in any environment (B-7).
CORS_ORIGINS=http://localhost:3000

# Hop count trusted from X-Forwarded-For so client IPs are correct behind a proxy.
# 0 (or unset) when the API is directly exposed. Getting this wrong breaks per-IP
# rate limiting and the consent IP record.
TRUST_PROXY=1

# debug | info | warn | error. `debug` also enables TypeORM query logging — query
# text can carry personal data, so keep it off outside local (E-12).
LOG_LEVEL=debug

# Mount the interactive docs at /api/docs and /api/docs-json. DEFAULTS TO false, in
# every environment.
#   SwaggerModule.setup() registers raw Express middleware, so it sits OUTSIDE the
#   §2.7 guard chain: no APP_GUARD runs on it and `npm run check:guards` cannot see
#   it. Anyone who can reach the port reads every path, DTO and error code.
#   Turn it on only where that is acceptable, and ONLY behind authentication —
#   reverse-proxy basic auth, an IP allow-list, or a private network. The API cannot
#   enforce it for you. Ignored entirely when NODE_ENV=production.
#   Left false here on purpose: this template gets copied to more places than the one
#   it was written for. Flip it to true in your own local .env.
EXPOSE_API_DOCS=false

# IANA zone used for cron schedules and the `YYYY-MM` ledger period boundary
# (quota_ledger.period / usage_ledger.period, §4.26).
TIMEZONE=Asia/Karachi


# ── Database (PostgreSQL 16) ──────────────────────────────────────────────────
# The API is the only process with database credentials (B-3).

# <<< REQUIRED — NO DEFAULT >>>
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example shape (do not use these credentials): postgresql://drape:CHANGE_ME@localhost:5432/drape
DATABASE_URL=

# TLS to the database, with certificate verification. `true` in staging/production.
DATABASE_SSL=false

# Connection pool ceiling. 10 locally; 20–50 in production.
DATABASE_POOL_MAX=10

# Connection pool floor.
DATABASE_POOL_MIN=2


# ── Sessions and CSRF ─────────────────────────────────────────────────────────
# Custom server-side sessions. No NextAuth, no JWT (§0).

# Name of the httpOnly session cookie.
SESSION_COOKIE_NAME=drape.sid

# <<< REQUIRED — NO DEFAULT >>>
# Parent domain so one cookie covers both the web and API origins (B-6).
# Local: .localhost   Deployed: .example.com
SESSION_COOKIE_DOMAIN=

# <<< REQUIRED — NO DEFAULT — 64 hex characters >>>
# HMAC key for session token derivation. Rotating it logs every user out.
SESSION_SECRET=

# `Secure` flag on the session cookie. `false` only on plain-HTTP localhost;
# `true` everywhere else, without exception.
SESSION_COOKIE_SECURE=false

# Sliding idle expiry for admin sessions, in hours (S-7).
SESSION_ADMIN_IDLE_HOURS=12

# Sliding idle expiry for consumer sessions, in days (S-7).
SESSION_CONSUMER_IDLE_DAYS=30

# Hard ceiling for an admin session regardless of activity, in days.
SESSION_ADMIN_ABSOLUTE_DAYS=7

# Hard ceiling for a consumer session regardless of activity, in days.
SESSION_CONSUMER_ABSOLUTE_DAYS=90

# Double-submit CSRF cookie. Readable by JavaScript by design (B-8).
CSRF_COOKIE_NAME=drape.csrf

# <<< REQUIRED — NO DEFAULT — 64 hex characters >>>
# HMAC key for CSRF token derivation. Must differ from SESSION_SECRET.
CSRF_SECRET=


# ── Password hashing and 2FA ──────────────────────────────────────────────────

# Argon2id memory cost in KiB (S-6). 19456 KiB = 19 MiB, the OWASP baseline.
ARGON2_MEMORY_KIB=19456

# Argon2id iterations.
ARGON2_TIME_COST=2

# Argon2id parallelism lanes.
ARGON2_PARALLELISM=1

# <<< REQUIRED — NO DEFAULT — 64 hex characters >>>
# AES-256-GCM key protecting `users.twofaSecret` (S-8). The TOTP secret is never
# stored in plaintext. Rotating this key invalidates every enrolled authenticator.
TWOFA_ENCRYPTION_KEY=

# Issuer label shown in the authenticator app.
TWOFA_ISSUER=Drape


# ── Storage ───────────────────────────────────────────────────────────────────
# Images live OUTSIDE the repository. The database stores the relative key only,
# never an absolute path (§0, §3.3).

# `local` in V1; `s3` later, with no call-site changes.
STORAGE_DRIVER=local

# <<< REQUIRED — NO DEFAULT >>>
# Absolute path to the media root, outside this repository. Startup fails if it
# resolves inside the repo tree, and `npm run storage:ensure` refuses to create it
# there. This directory is never served by a static file handler — the only read
# path is GET /api/v1/files/:token.
# Example (Windows dev machine): D:/drape-storage
STORAGE_ROOT=D:/drape-storage

# <<< REQUIRED — NO DEFAULT — 64 hex characters >>>
# HMAC key for signed download tokens and upload tickets (§3.4, §3.5). Rotating it
# invalidates every outstanding URL immediately, which is the intended kill switch.
STORAGE_URL_SECRET=

# Signed-URL lifetime for `person-photos/**`, in seconds. Keep it short.
STORAGE_URL_TTL_PHOTO_SECONDS=300

# Signed-URL lifetime for `renders/**`, in seconds.
STORAGE_URL_TTL_RENDER_SECONDS=900

# Signed-URL lifetime for public assets — garments, categories, brand,
# reference-models, non-private thumbnails — in seconds.
STORAGE_URL_TTL_PUBLIC_SECONDS=3600

# Upload-ticket lifetime, in seconds.
STORAGE_UPLOAD_TICKET_TTL_SECONDS=900

# Hard per-file upload ceiling, in megabytes. Enforced while streaming, not after.
STORAGE_MAX_UPLOAD_MB=25

# Free-space floor, in megabytes. Below this /health/ready degrades and an alert
# fires (E-14).
STORAGE_MIN_FREE_MB=2048


# ── TryOnCloud (generation provider) ──────────────────────────────────────────
# Behind the `TryOnProvider` interface. See §0 and the note below.

# mock | http
#
# ⚠ KEEP THIS `mock` IN LOCAL AND CI — ALWAYS.
#   The upstream TryOnCloud account has a total budget of TEN images. Every `http`
#   generation permanently spends one of them. A single test run on the http driver
#   can exhaust the entire account, and there is no way to get the budget back.
#   The mock driver returns a deterministic placeholder render with configurable
#   latency and failure rate, which is what the wait UI and the E-6 failure-taxonomy
#   tests are written against. Only a human, deliberately, on a real machine, with a
#   reason, ever sets this to `http`.
TRYON_DRIVER=mock

# Upstream base URL. Required only when TRYON_DRIVER=http.
# The published base is https://www.tryoncloud.com/api/v1 — the driver posts /generate under it,
# sends the key in an X-API-KEY header (keys are prefixed tk_dev_v1_), and expects raw PNG bytes.
# Server-side only: the key never leaves this service (B-1).
TRYONCLOUD_BASE_URL=https://www.tryoncloud.com/api/v1

# <<< REQUIRED WHEN TRYON_DRIVER=http — NO DEFAULT >>>
# API-service-only secret (B-1). It never reaches the web service, never appears in
# a log, and is rotated quarterly (E-17). Leave EMPTY while TRYON_DRIVER=mock.
TRYONCLOUD_API_KEY=

# Third component of the content-hash cache key (§3.7). Bumping this invalidates
# the whole render cache without a migration.
TRYON_API_VERSION=2026-08-01

# Per-attempt upstream timeout in milliseconds (E-11). Measured against the real
# TryOnCloud endpoint: a render lands at roughly 20s, so 20000 aborts nearly every
# attempt at the line and burns all three on one generation. Keep the headroom.
TRYON_TIMEOUT_MS=60000

# Retry ceiling per job (§8.3). `tryon_jobs.attempts` is capped at this.
TRYON_MAX_ATTEMPTS=3

# Exponential backoff base in milliseconds between attempts.
TRYON_BACKOFF_BASE_MS=800

# Hard ceiling on one upstream response body, in bytes (E-11). A render is a PNG of
# roughly the same order as the photo that produced it, so this matches
# STORAGE_MAX_UPLOAD_MB. It exists because axios buffers a whole response before the
# provider can look at it: without a ceiling a compromised upstream can spend a
# megabyte of gzip to make the single API process allocate gigabytes — three times over,
# once per attempt — and take every live SSE result stream down with it. Transparent
# decompression is off for the same reason.
TRYON_MAX_RESPONSE_BYTES=26214400

# Concurrency for A-12 bulk admin test renders. Kept at 1 so a batch never competes
# with a live consumer generation (§8.2).
TRYON_TEST_RENDER_CONCURRENCY=1

# Mock driver latency in milliseconds, so the wait UI is exercised honestly against
# a realistic generation time rather than an instant response.
TRYON_MOCK_LATENCY_MS=7000

# Mock driver failure rate, 0–1. E-6 raises this to walk the §8.3 failure taxonomy.
TRYON_MOCK_FAILURE_RATE=0


# ── Email ─────────────────────────────────────────────────────────────────────

# console | smtp. `console` writes the rendered message to the structured logger
# instead of sending it — the local and CI default.
EMAIL_DRIVER=console

# From header on every outbound message.
EMAIL_FROM=Drape <hello@example.com>

# SMTP transport. Required only when EMAIL_DRIVER=smtp.
SMTP_HOST=
SMTP_PORT=587

# <<< REQUIRED WHEN EMAIL_DRIVER=smtp — NO DEFAULT >>>
SMTP_USER=
SMTP_PASSWORD=

# Implicit TLS (true for port 465, false for 587 + STARTTLS).
SMTP_SECURE=false


# ── SMS (phone OTP, C-3) ──────────────────────────────────────────────────────

# console | http. `console` logs the OTP instead of sending it — local and CI only.
SMS_DRIVER=console

# Regional SMS gateway endpoint. Required only when SMS_DRIVER=http.
SMS_HTTP_URL=

# <<< REQUIRED WHEN SMS_DRIVER=http — NO DEFAULT >>>
SMS_HTTP_API_KEY=

# Alphanumeric sender id registered with the gateway.
SMS_SENDER_ID=DRAPE


# ── Token lifetimes ───────────────────────────────────────────────────────────

# Phone OTP lifetime in seconds (C-3).
OTP_TTL_SECONDS=600

# Password-reset link lifetime in minutes (S-6).
PASSWORD_RESET_TTL_MINUTES=30

# Email-verification link lifetime in hours.
EMAIL_VERIFY_TTL_HOURS=24

# Admin invite lifetime in days (S-5).
INVITE_TTL_DAYS=7


# ── Rate limiting and lockout ─────────────────────────────────────────────────

# Global throttle window in seconds.
THROTTLE_TTL_SECONDS=60

# Global throttle limit per window, per user id or IP.
THROTTLE_LIMIT=100

# Per-account generation ceiling per hour, applied independently of monthly quota (C-6).
TRYON_RATE_PER_HOUR=20

# Per-IP generation ceiling per hour (C-6).
TRYON_RATE_PER_IP_HOUR=40

# Failed logins before lockout, counted per email hash AND per IP independently (S-6).
LOGIN_LOCKOUT_THRESHOLD=5

# Exponential lockout backoff ceiling in minutes.
LOGIN_LOCKOUT_MAX_MINUTES=60


# ── Quota and budget seed values ──────────────────────────────────────────────
# These SEED the `settings` rows. Once seeded, the database row is authoritative and
# an admin edits it through PATCH /api/v1/settings — changing the variable afterwards
# does not move the live value. Remaining quota and remaining budget are always
# DERIVED with SUM(delta) over the append-only ledgers, never stored (§4.0 rule 10).

# Seeds settings['quota.defaultMonthly'] (A-28, C-5).
QUOTA_DEFAULT_MONTHLY=15

# Seeds settings['budget.monthlyGenerations'] (A-29).
BUDGET_DEFAULT_MONTHLY=2000

# Seeds settings['budget.warnThresholdPercent'] — soft warning threshold (A-29, E-14).
BUDGET_WARN_PERCENT=80


# ── Retention (§9.3) ──────────────────────────────────────────────────────────

# Person photos are purged this many days after the account's last activity. Also
# seeds the policy version's `retentionSummary.photoDays` (C-11).
PHOTO_RETENTION_DAYS=30

# `tryon_jobs` pruning window in days. Renders in history are NOT affected — they
# carry no expiry, deliberately (C-27).
JOB_RETENTION_DAYS=90

# Consumer-initiated deletion SLA in hours (C-38, A-20).
DELETION_SLA_HOURS=24


# ── Seed script (npm run seed) ────────────────────────────────────────────────
# Read only by apps/api/src/seeders/*. The seeder FAILS LOUDLY when these are unset —
# there is no hardcoded first-admin account anywhere in the codebase (E-4, E-2, S-5).

# <<< REQUIRED FOR `npm run seed` — NO DEFAULT >>>
# Email address of the first Admin. Example: admin@example.com
SEED_ADMIN_EMAIL=

# <<< REQUIRED FOR `npm run seed` — NO DEFAULT >>>
# Password for the first Admin. Minimum 12 characters. Argon2id-hashed at seed time
# and never stored in plaintext. Rotate it immediately after the first login, then
# clear this variable.
SEED_ADMIN_PASSWORD=

# <<< REQUIRED FOR `npm run seed` — NO DEFAULT >>>
# Display name of the first Admin. Example: Studio Admin
SEED_ADMIN_NAME=


# ── Local docker-compose only ─────────────────────────────────────────────────
# Consumed by backend/docker-compose.yml (`docker compose up -d`), NOT by the API.
# They must describe the same database DATABASE_URL points at. Omit them entirely on
# a machine with no Docker daemon — the compose file is documentation there.

POSTGRES_DB=drape
POSTGRES_USER=drape

# <<< REQUIRED FOR docker compose — NO DEFAULT >>>
# Local-only database password. Must match the password inside DATABASE_URL.
POSTGRES_PASSWORD=

# Host port mapped to the container's 5432.
POSTGRES_PORT=5432

# Host port for the Adminer web UI.
ADMINER_PORT=8080
