{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "outDir": "../../dist/apps/api",
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts",
    "**/*.e2e-spec.ts",
    // Test doubles and factories sit beside the code they exercise so they are
    // easy to find, but they reference jest globals — `types` above is ["node"],
    // and they must never reach the production bundle regardless.
    "**/testing/**",
    "**/*.fixtures.ts"
  ]
}
