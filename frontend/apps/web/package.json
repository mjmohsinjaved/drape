    "@tanstack/react-query": "^5.75.5",
    "lucide-react": "^0.507.0",
    "next": "^15.3.1",
    "next-intl": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@repo/config-eslint": "*",
    "@repo/config-tailwind": "*",
    "@repo/config-typescript": "*",
