  "description": "Drape — the one Next.js app that serves both the admin console and the consumer fitting room (PRD S-2).",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
