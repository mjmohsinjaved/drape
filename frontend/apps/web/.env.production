# Production. Web and API share a parent domain so one session cookie covers both (B-6).
# No secrets: no TryOnCloud key, no database URL, no session secret (B-1, B-2, B-3).
NEXT_PUBLIC_API_BASE_URL=https://api.drape.example/api/v1
NEXT_PUBLIC_SITE_URL=https://app.drape.example
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_ENABLE_QUERY_DEVTOOLS=false

API_INTERNAL_URL=http://api:4000/api/v1
