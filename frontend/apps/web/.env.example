# Drape — web service environment template (ARCHITECTURE §7, the `web` rows).
#
# The web service holds NO secrets: no TryOnCloud key, no database URL, no session secret
# (B-1, B-2, B-3). If a variable would give this app a business decision or an upstream
# credential, it belongs in the API instead. Nothing here has a fallback default in code —
# a missing required variable fails the build, never a request (E-2).
#
# Copy to `.env.local` for personal overrides. `.env.local` is git-ignored; this file is not.

# --- Required ---------------------------------------------------------------------------

# Browser -> API base (B-9). The browser calls the API directly; there is no proxy layer here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Canonical origin for metadata, Open Graph and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# development | staging | production (E-1). Distinct from NODE_ENV.
NEXT_PUBLIC_APP_ENV=development

# --- Optional ---------------------------------------------------------------------------

# Server-side base for cookie-forwarded fetches from Server Components. Lets the container
# reach the API over an internal network name. Falls back to NEXT_PUBLIC_API_BASE_URL.
API_INTERNAL_URL=http://localhost:4000/api/v1

# Fallback when locale negotiation finds nothing. `en` or `ur`.
NEXT_PUBLIC_DEFAULT_LOCALE=en

# TanStack Query devtools. Never `true` in production.
NEXT_PUBLIC_ENABLE_QUERY_DEVTOOLS=true
