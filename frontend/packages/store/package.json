{
  "name": "@repo/store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drape client state (Zustand). Client state only — anything the API owns lives in TanStack Query. Source-first: consumers transpile it via next.config transpilePackages.",
  "license": "UNLICENSED",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"const f=require('fs');for(const d of ['.turbo','coverage'])f.rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@repo/api-client": "*",
    "@repo/utils": "*",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@repo/config-eslint": "*",
    "@repo/config-typescript": "*",
    "@types/react": "^19.1.3",
    "eslint": "^9.26.0",
    "react": "^19.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
