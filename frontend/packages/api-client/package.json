{
  "name": "@repo/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drape HTTP + TanStack Query layer. Envelope unwrapping (ARCHITECTURE §2.3), typed ErrorCode normalisation (§2.4), and the DTO half of the B-4 contract for every route in §5. Source-first: consumers transpile it via next.config transpilePackages.",
  "license": "UNLICENSED",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server-instance.ts",
      "default": "./src/server-instance.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"const f=require('fs');for(const d of ['.turbo','coverage'])f.rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.75.5",
    "@tanstack/react-query-devtools": "^5.75.5",
    "axios": "^1.9.0"
  },
  "devDependencies": {
    "@repo/config-eslint": "*",
    "@repo/config-typescript": "*",
    "@repo/utils": "*",
    "@types/react": "^19.1.3",
    "eslint": "^9.26.0",
    "next-intl": "^4.13.5",
    "react": "^19.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "next-intl": "^4.0.0"
  }
}
