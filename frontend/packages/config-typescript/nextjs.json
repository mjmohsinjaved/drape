{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Drape Next.js app",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "allowJs": true,
    "incremental": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "exclude": ["node_modules", ".next", ".turbo", "coverage"]
}
