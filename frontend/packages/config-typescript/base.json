{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Drape base",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,

    // Deliberately FALSE. It is too noisy against third-party React/Next/Radix
    // typings, which pass `prop: undefined` freely; turning it on buries real
    // errors under hundreds of library-boundary false positives.
    // (A "//prefixed" key is not a comment — tsc rejects it as an unknown option.)
    "exactOptionalPropertyTypes": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    "pretty": true
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo", "coverage"]
}
