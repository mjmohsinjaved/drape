{
  "name": "@repo/config-eslint",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared ESLint 9 flat configs for the Drape frontend workspace.",
  "license": "UNLICENSED",
  "exports": {
    "./base": "./base.js",
    "./react": "./react.js",
    "./next": "./next.js",
    "./base.mjs": "./base.js",
    "./react.mjs": "./react.js",
    "./next.mjs": "./next.js"
  },
  "files": [
    "base.js",
    "react.js",
    "next.js"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "clean": "node -e \"require('fs').rmSync('.turbo',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@next/eslint-plugin-next": "^15.3.1",
    "@repo/config-typescript": "*",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-turbo": "^2.5.3",
    "globals": "^16.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "typescript": "^5.5.0"
  }
}
